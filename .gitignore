# Jupyter
.ipynb_checkpoints
# Note: The main notebooks are tracked (HSA_v6_FINAL.ipynb is the primary production notebook,
# Patient_Allocation_for_Modeling.ipynb and Generate_Modeling_Dataset.ipynb for disease modeling workflow,
# GEE_Climate_Features_by_Facilities.ipynb, GEE_HSA_Weekly_Climate_Lagged.ipynb)
# All other notebooks are ignored
*.ipynb
!HSA_v6_FINAL.ipynb
!Patient_Allocation_for_Modeling.ipynb
!Generate_Modeling_Dataset.ipynb
!HSA_v5_FINAL_PENALTY_BASED.ipynb
!GEE_Climate_Features_by_Facilities.ipynb
!GEE_HSA_Weekly_Climate_Lagged.ipynb
!GEE_local_Climate_Features_by_Facilities.ipynb
!GEE_local_HSA_Weekly_Climate_Lagged.ipynb
!compare_delineations.ipynb
!run_climate_health_modeling.ipynb

